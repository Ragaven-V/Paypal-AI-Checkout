PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000
MOCK_AI=false
# Gemini 3 thinking level: minimal | low | medium | high (empty = model default).
# Do NOT use thinkingBudget with Gemini 3 models: it is rejected with 400 INVALID_ARGUMENT.
GEMINI_THINKING_LEVEL=low
# Explicit context caching (needs >= ~4096 prompt tokens on Gemini 3; implicit caching is automatic)
GEMINI_EXPLICIT_CACHE=false
# PayPal webhook ID from developer.paypal.com > your app > Webhooks (enables /api/paypal/webhook)
PAYPAL_WEBHOOK_ID=
# Behind a reverse proxy set to the number of proxy hops (e.g. 1) so rate limiting sees real client IPs
TRUST_PROXY=
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_API_PER_MIN=120
# SQLite file for orders and webhook events (Node >= 22.13 built-in node:sqlite)
DATABASE_PATH=./data/ai-checkout.db
# Password for the /admin orders page (admin is disabled when empty)
ADMIN_TOKEN=

# --- Checkout pricing (integer cents) ---
SHIPPING_FLAT_CENTS=599
FREE_SHIPPING_THRESHOLD_CENTS=5000
# Sales tax % on the items subtotal, e.g. 8.25 (0 = no tax)
TAX_RATE_PERCENT=0

# --- Accounts ---
AUTH_SESSION_DAYS=30
RATE_LIMIT_AUTH_PER_MIN=10

# --- Gemini resilience ---
GEMINI_TIMEOUT_MS=20000
GEMINI_RETRY_ATTEMPTS=2

# --- Operations ---
# json (hosting platforms) or pretty (local). Defaults to json when NODE_ENV=production.
LOG_FORMAT=pretty
LOG_LEVEL=info
# Backups of the SQLite file (empty BACKUP_DIR = <database folder>/backups; 0 hours = off)
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=7
